{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azazy human and AI conversation audit v0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.2"
      ]
    },
    "conversation_id": {
      "type": "integer"
    },
    "resolution_event_id": {
      "type": "string"
    },
    "summary_ar": {
      "type": "string"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "inquiry_answered",
            "awaiting_payment",
            "payment_reported",
            "order_confirmed",
            "customer_cancelled",
            "handled_in_person",
            "unresolved",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "integer"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "message_id",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "category",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "human_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "integer"
          },
          "summary_ar": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "string",
                  "enum": [
                    "requirements",
                    "accuracy",
                    "follow_through",
                    "communication",
                    "closure"
                  ]
                },
                "rating": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 4
                },
                "assessment": {
                  "type": "string",
                  "enum": [
                    "assessed",
                    "not_applicable",
                    "insufficient_evidence"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "message_id": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "message_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "dimension",
                "rating",
                "assessment",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "message_id": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "message_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "description",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "agent_id",
          "summary_ar",
          "dimensions",
          "strengths"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "integer"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "message_id",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "agent_id",
          "category",
          "severity",
          "title",
          "explanation",
          "recommended_action",
          "evidence",
          "rule_ids"
        ],
        "additionalProperties": false
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_review": {
      "type": "boolean"
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "assessed",
            "insufficient_evidence",
            "no_ai_replies"
          ]
        },
        "summary_ar": {
          "type": "string"
        },
        "covered_message_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ai_message_id": {
                "type": "integer"
              },
              "category": {
                "type": "string",
                "enum": [
                  "incorrect_information",
                  "unsupported_claim",
                  "missed_requirement",
                  "context_loss",
                  "media_misunderstanding",
                  "payment_handling",
                  "handoff",
                  "repetition",
                  "tone",
                  "other"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "title": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "recommended_action": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "message_id": {
                      "type": "integer"
                    },
                    "quote": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message_id",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "ai_message_id",
              "category",
              "severity",
              "title",
              "explanation",
              "recommended_action",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "improvement_suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "summary_ar",
        "covered_message_ids",
        "issues",
        "strengths",
        "improvement_suggestions",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "resolution_event_id",
    "summary_ar",
    "outcome",
    "human_evaluations",
    "issues",
    "missing_context",
    "needs_review",
    "review_reasons",
    "ai_review"
  ],
  "additionalProperties": false
}
