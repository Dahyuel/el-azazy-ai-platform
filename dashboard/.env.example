# Copy to .env; use a separate development Chatwoot instance.
PGHOST=your-postgres-host
PGUSER=your_readonly_role
PGPASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
CHATWOOT_URL=http://your-chatwoot-host:3000
CHATWOOT_PUBLIC_URL=https://chatwoot.example.com
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DATA_DIR=./data
BIND_HOST=127.0.0.1
PORT=8787
# Leave blank to keep real evaluation off.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DISABLE_BACKGROUND=1
