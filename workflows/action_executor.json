      "parameters": {
        "jsCode": "const Redis = require('/files/node_modules/ioredis');\nconst fs = require('fs');\nconst cfg = JSON.parse(fs.readFileSync('/files/redis.json', 'utf8'));\n\nconst MAX_PER_RUN = 20;\n\nconst actions = await (async () => {\n  const r = new Redis({\n    host: cfg.host || 'botredis',\n    port: cfg.port || 6379,\n    password: cfg.password,\n    connectTimeout: 4000,\n    maxRetriesPerRequest: 2\n  });\n  r.on('error', () => {});\n  try {\n    const out = [];\n    for (let i = 0; i < MAX_PER_RUN; i++) {\n      const raw = await r.lpop('pending_actions');\n      if (!raw) break;\n      try {\n        const obj = JSON.parse(raw);\n        out.push({ json: obj });\n      } catch (e) {}\n    }\n    return out;\n  } finally {\n    r.disconnect();\n  }\n})();\n\nreturn actions;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
